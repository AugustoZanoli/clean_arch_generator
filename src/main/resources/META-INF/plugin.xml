<idea-plugin>
    <id>com.cag.cag</id>
    <name>Cag — Clean Architecture Generator</name>
    <vendor email="augusto.zanoli@gmail.com">Augusto Zanoli</vendor>

    <description><![CDATA[
        Gera os arquivos de uma nova feature seguindo a arquitetura (Clean Architecture) definida
        no arquivo <code>.cag/config.json</code> do projeto.<br>
        Abra a janela pelo atalho <b>Ctrl+Alt+Shift+N</b>, digite o nome da feature e confirme os
        arquivos no preview — eles são criados nas pastas certas, com package e imports resolvidos.
        ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>org.jetbrains.kotlin</depends>

    <extensions defaultExtensionNs="com.intellij">
        <projectConfigurable
                parentId="tools"
                instance="com.cag.settings.CagConfigurable"
                id="com.cag.settings.CagConfigurable"
                displayName="Cag — Clean Architecture Generator"/>
    </extensions>
    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <supportsKotlinPluginMode supportsK2="true" />
    </extensions>

    <extensions defaultExtensionNs="com.intellij">
        <postStartupActivity implementation="com.cag.config.CagConfigInitializer"/>
    </extensions>

    <actions>
        <action id="com.cag.GenerateFeature"
                class="com.cag.ui.GenerateFeatureAction"
                text="Gerar Feature (Clean Architecture)…"
                description="Cria os arquivos de uma nova feature seguindo a arquitetura definida"
                icon="AllIcons.General.Add">
            <add-to-group group-id="ToolsMenu" anchor="first"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="first"/>
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt shift N"/>
        </action>
    </actions>
</idea-plugin>
